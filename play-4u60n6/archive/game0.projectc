[project]
title = Pixel Stones
version = 0.11.9
publisher = 
developer = 
write_log = 0
write_log_file = 0
minimum_log_level = 1
compress_archive = 1
dependencies_metadata = 0
custom_resources = /levels
title_as_file_name = PixelStones

[display]
width = 720
height = 1280
high_dpi = 1
samples = 0
fullscreen = 0
display_profiles = /builtins/render/default.display_profilesc
dynamic_orientation = 0
update_frequency = 0
swap_interval = 1
vsync = 1
variable_dt = 0
display_device_info = 0

[render]
clear_color_red = 0.98
clear_color_green = 0.96
clear_color_blue = 0.93
clear_color_alpha = 1

[physics]
max_collision_object_count = 0
type = 2D
use_fixed_timestep = 0
debug = 0
debug_alpha = 0.9
debug_scale = 30
world_count = 4
gravity_x = 0
gravity_y = -10
gravity_z = 0
scale = 1
allow_dynamic_transforms = 1
max_collisions = 64
max_contacts = 128
contact_impulse_limit = 0
ray_cast_limit_2d = 64
ray_cast_limit_3d = 128
trigger_overlap_capacity = 16
velocity_threshold = 1
max_fixed_timesteps = 2

[box2d]
velocity_iterations = 10
position_iterations = 10
sub_step_count = 4

[bootstrap]
main_collection = /main/main.collectionc
render = /render/main.renderc
debug_init_script = 

[graphics]
default_texture_min_filter = linear_mipmap_linear
default_texture_mag_filter = linear
max_draw_calls = 1024
max_characters = 8192
max_font_batches = 128
max_debug_vertices = 10000
texture_profiles = /assets/game.texture_profiles
verify_graphics_calls = 1
webgl_version_hint = 2
opengl_version_hint = 33
opengl_core_profile_hint = 1
vulkan_version_major = 1
vulkan_version_minor = 0
memory_size = 512

[shader]
output_spirv = 0
glsl_es_default_precision_float = mediump
glsl_es_default_precision_int = highp

[sound]
gain = 1
use_linear_gain = 1
max_sound_data = 128
max_sound_buffers = 32
max_sound_sources = 16
max_sound_instances = 256
max_component_count = 32
sample_frame_count = 0
use_thread = 1
stream_enabled = 0
stream_chunk_size = 16384
stream_preload_size = 16384
stream_cache_size = 2097152

[resource]
http_cache = 0
max_resources = 1024

[input]
repeat_delay = 0.5
repeat_interval = 0.2
gamepads = /builtins/input/default.gamepadsc
gamepad_deadzone = 0.2
game_binding = /input/game.input_bindingc
use_accelerometer = 1

[sprite]
max_count = 4096
subpixels = 1

[model]
max_count = 128
split_meshes = 0
max_bone_matrix_texture_width = 1024
max_bone_matrix_texture_height = 1024
max_morph_target_texture_width = 1024
max_morph_target_texture_height = 1024

[mesh]
max_count = 128

[light]
max_count = 64

[gui]
max_count = 64
max_animation_count = 1024
max_particle_count = 1024
max_particlefx_count = 64
safe_area_mode = both

[collection]
max_instances = 4096
max_input_stack_entries = 16

[collection_proxy]
max_count = 8

[collectionfactory]
max_count = 128

[factory]
max_count = 64

